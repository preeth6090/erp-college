generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Campus {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  name       String
  city       String
  state      String
  address    String?
  phone      String?
  email      String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  colleges College[]
  users    User[]

  @@map("campuses")
}

model College {
  id                     Int      @id @default(autoincrement())
  campus_id              Int
  code                   String   @unique
  name                   String
  university_affiliation String?
  aishe_code             String?
  naac_grade             String?
  principal_name         String?
  is_active              Boolean  @default(true)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  campus      Campus       @relation(fields: [campus_id], references: [id], onDelete: Cascade)
  users       User[]
  departments Department[]
  students    Student[]
  employees   Employee[]

  @@map("colleges")
}

model AcademicYear {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  start_date DateTime
  end_date   DateTime
  is_current Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  academicSessions AcademicSession[]

  @@map("academic_years")
}

model FinancialYear {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  start_date DateTime
  end_date   DateTime
  is_current Boolean  @default(false)
  is_closed  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("financial_years")
}

model Role {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  rolePermissions RolePermission[]
  users           User[]

  @@map("roles")
}

model Permission {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  name       String
  module     String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       Int
  permission_id Int

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permission")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  email_verified_at DateTime?
  password          String
  role_id           Int?
  campus_id         Int?
  college_id        Int?
  phone             String?
  status            String    @default("Active")
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  role                  Role?                  @relation(fields: [role_id], references: [id], onDelete: SetNull)
  campus                Campus?                @relation(fields: [campus_id], references: [id], onDelete: SetNull)
  college               College?               @relation(fields: [college_id], references: [id], onDelete: SetNull)
  auditLogs             AuditLog[]
  admissionEnquiries    AdmissionEnquiry[]
  enquiryFollowups      EnquiryFollowup[]
  students              Student[]
  studentGuardians      StudentGuardian[]
  employees             Employee[]
  employeeLeaves        EmployeeLeave[]
  studentAttendances    StudentAttendance[]
  attendanceCorrections AttendanceCorrection[]
  libraryIssues         LibraryIssue[]
  financialVouchers     FinancialVoucher[]
  purchaseRequisitions  PurchaseRequisition[]
  lmsDiscussions        LmsDiscussion[]
  grievances            Grievance[]
  announcements         Announcement[]

  @@map("users")
}

model SystemSetting {
  id         Int      @id @default(autoincrement())
  group_name String   @default("general")
  key        String   @unique
  value      String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("system_settings")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     Int?
  action      String
  module      String
  record_type String?
  record_id   Int?
  description String?
  ip_address  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Department {
  id         Int      @id @default(autoincrement())
  college_id Int
  code       String   @unique
  name       String
  hod_name   String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  college              College               @relation(fields: [college_id], references: [id], onDelete: Cascade)
  courses              Course[]
  students             Student[]
  employees            Employee[]
  financialVouchers    FinancialVoucher[]
  departmentBudgets    DepartmentBudget[]
  fixedAssets          FixedAsset[]
  purchaseRequisitions PurchaseRequisition[]
  inventoryItems       InventoryItem[]
  campusEvents         CampusEvent[]
  accreditationRecords AccreditationRecord[]
  researchRecords      ResearchRecord[]
  announcements        Announcement[]

  @@map("departments")
}

model Course {
  id                Int      @id @default(autoincrement())
  department_id     Int
  code              String   @unique
  name              String
  level             String   @default("Undergraduate")
  duration_years    Int      @default(3)
  total_semesters   Int      @default(6)
  total_credits     Int      @default(120)
  intake_capacity   Int      @default(60)
  cutoff_percentage Float    @default(50.00)
  nep_2020_enabled  Boolean  @default(true)
  cbcs_enabled      Boolean  @default(true)
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  department            Department             @relation(fields: [department_id], references: [id], onDelete: Cascade)
  subjects              Subject[]
  admissionEnquiries    AdmissionEnquiry[]
  admissionApplications AdmissionApplication[]
  students              Student[]
  classSections         ClassSection[]
  exams                 Exam[]
  feeStructures         FeeStructure[]
  alumnuses             Alumnus[]

  @@map("courses")
}

model AcademicSession {
  id               Int      @id @default(autoincrement())
  academic_year_id Int
  name             String
  term             String   @default("Odd")
  start_date       DateTime
  end_date         DateTime
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  academicYear          AcademicYear           @relation(fields: [academic_year_id], references: [id], onDelete: Cascade)
  academicCalendars     AcademicCalendar[]
  admissionApplications AdmissionApplication[]
  subjectAllocations    SubjectAllocation[]
  exams                 Exam[]
  studentFeeAccounts    StudentFeeAccount[]
  scholarships          Scholarship[]

  @@map("academic_sessions")
}

model Subject {
  id                 Int      @id @default(autoincrement())
  course_id          Int
  code               String   @unique
  name               String
  semester           Int      @default(1)
  credits            Float    @default(4.0)
  subject_type       String   @default("Core")
  max_internal_marks Int      @default(30)
  max_external_marks Int      @default(70)
  syllabus_summary   String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  course             Course              @relation(fields: [course_id], references: [id], onDelete: Cascade)
  subjectAllocations SubjectAllocation[]
  timetableSlots     TimetableSlot[]
  studentAttendances StudentAttendance[]
  examSchedules      ExamSchedule[]
  examMarks          ExamMark[]
  lmsMaterials       LmsMaterial[]
  lmsAssignments     LmsAssignment[]
  lmsDiscussions     LmsDiscussion[]

  @@map("subjects")
}

model AcademicCalendar {
  id                  Int       @id @default(autoincrement())
  academic_session_id Int
  title               String
  event_type          String    @default("Academic")
  start_date          DateTime
  end_date            DateTime?
  description         String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  academicSession AcademicSession @relation(fields: [academic_session_id], references: [id], onDelete: Cascade)

  @@map("academic_calendars")
}

model AdmissionEnquiry {
  id                 Int       @id @default(autoincrement())
  enquiry_no         String    @unique
  student_name       String
  phone              String
  email              String?
  source             String    @default("Walk-in")
  campaign_name      String?
  course_id          Int?
  counsellor_id      Int?
  status             String    @default("New")
  lost_reason        String?
  next_followup_date DateTime?
  notes              String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  course           Course?           @relation(fields: [course_id], references: [id], onDelete: SetNull)
  counsellor       User?             @relation(fields: [counsellor_id], references: [id], onDelete: SetNull)
  enquiryFollowups EnquiryFollowup[]

  @@map("admission_enquiries")
}

model EnquiryFollowup {
  id                   Int      @id @default(autoincrement())
  admission_enquiry_id Int
  user_id              Int?
  followup_at          DateTime
  notes                String
  outcome              String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  admissionEnquiry AdmissionEnquiry @relation(fields: [admission_enquiry_id], references: [id], onDelete: Cascade)
  user             User?            @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("enquiry_followups")
}

model AdmissionApplication {
  id                     Int       @id @default(autoincrement())
  application_no         String    @unique
  academic_session_id    Int?
  course_id              Int
  full_name              String
  email                  String
  phone                  String
  dob                    DateTime?
  gender                 String    @default("Male")
  category               String    @default("General")
  aadhaar_number         String?
  aadhaar_consent        Boolean   @default(false)
  father_name            String?
  mother_name            String?
  address                String?
  class_10_board         String?
  class_10_percentage    Float?
  class_12_board         String?
  class_12_percentage    Float?
  previous_qualification String?
  entrance_exam_name     String?
  entrance_score         Float?
  merit_score            Float?
  merit_rank             Int?
  photo_path             String?
  signature_path         String?
  documents_json         String?
  application_fee_amount Float     @default(500.00)
  application_fee_status String    @default("Pending")
  payment_txn_id         String?
  status                 String    @default("Submitted")
  registration_number    String?
  refund_amount          Float     @default(0)
  remarks                String?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  academicSession AcademicSession? @relation(fields: [academic_session_id], references: [id], onDelete: SetNull)
  course          Course           @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("admission_applications")
}

model Student {
  id                        Int       @id @default(autoincrement())
  user_id                   Int?
  college_id                Int
  department_id             Int
  course_id                 Int
  current_semester          Int       @default(1)
  class_section_id          Int?
  unique_student_id         String    @unique
  admission_number          String    @unique
  registration_number       String?
  roll_number               String?
  full_name                 String
  email                     String    @unique
  phone                     String
  dob                       DateTime?
  gender                    String    @default("Male")
  blood_group               String?
  category                  String    @default("General")
  religion                  String?
  aadhaar_last4             String?
  photo_path                String?
  permanent_address         String?
  correspondence_address    String?
  emergency_contact_name    String?
  emergency_contact_phone   String?
  previous_academic_history String?
  admission_date            DateTime
  status                    String    @default("Active")
  transfer_migration_notes  String?
  created_at                DateTime  @default(now())
  updated_at                DateTime  @updatedAt

  user                    User?                    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  college                 College                  @relation(fields: [college_id], references: [id], onDelete: Cascade)
  department              Department               @relation(fields: [department_id], references: [id], onDelete: Cascade)
  course                  Course                   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  studentGuardians        StudentGuardian[]
  studentDocuments        StudentDocument[]
  studentAttendances      StudentAttendance[]
  examRegistrations       ExamRegistration[]
  examMarks               ExamMark[]
  studentFeeAccounts      StudentFeeAccount[]
  feePayments             FeePayment[]
  hostelAllocations       HostelAllocation[]
  hostelActivities        HostelActivity[]
  transportAllocations    TransportAllocation[]
  lmsSubmissions          LmsSubmission[]
  placementApplications   PlacementApplication[]
  scholarshipApplications ScholarshipApplication[]
  certificates            Certificate[]
  grievances              Grievance[]
  disciplinaryRecords     DisciplinaryRecord[]
  eventRegistrations      EventRegistration[]
  alumnuses               Alumnus[]

  @@map("students")
}

model StudentGuardian {
  id             Int      @id @default(autoincrement())
  student_id     Int
  parent_user_id Int?
  relation       String   @default("Father")
  name           String
  phone          String
  email          String?
  occupation     String?
  annual_income  Float?
  is_primary     Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  student    Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  parentUser User?   @relation(fields: [parent_user_id], references: [id], onDelete: SetNull)

  @@map("student_guardians")
}

model StudentDocument {
  id            Int      @id @default(autoincrement())
  student_id    Int
  document_type String
  file_path     String
  is_verified   Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("student_documents")
}

model Employee {
  id                    Int       @id @default(autoincrement())
  user_id               Int?
  college_id            Int
  department_id         Int?
  staff_id              String    @unique
  full_name             String
  email                 String    @unique
  phone                 String
  employee_type         String    @default("Faculty")
  designation           String
  qualification         String?
  experience_years      Int       @default(0)
  specialization        String?
  joining_date          DateTime
  resignation_date      DateTime?
  status                String    @default("Active")
  basic_salary          Float     @default(35000.00)
  bank_account_no       String?
  ifsc_code             String?
  pan_number            String?
  uan_number            String?
  esi_number            String?
  weekly_workload_hours Int       @default(18)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  user                             User?                @relation(fields: [user_id], references: [id], onDelete: SetNull)
  college                          College              @relation(fields: [college_id], references: [id], onDelete: Cascade)
  department                       Department?          @relation(fields: [department_id], references: [id], onDelete: SetNull)
  employeeLeaves                   EmployeeLeave[]
  employeeEvaluations              EmployeeEvaluation[]
  salaryStructures                 SalaryStructure[]
  payrolls                         Payroll[]
  classSections                    ClassSection[]
  subjectAllocations               SubjectAllocation[]
  timetableSlots_faculty           TimetableSlot[]      @relation("TimetableSlot_faculty_id")
  timetableSlots_substituteFaculty TimetableSlot[]      @relation("TimetableSlot_substitute_faculty_id")
  employeeAttendances              EmployeeAttendance[]
  examSchedules                    ExamSchedule[]
  hostels                          Hostel[]
  lmsMaterials                     LmsMaterial[]
  lmsAssignments                   LmsAssignment[]

  @@map("employees")
}

model EmployeeLeave {
  id          Int      @id @default(autoincrement())
  employee_id Int
  leave_type  String   @default("Casual")
  from_date   DateTime
  to_date     DateTime
  days        Int      @default(1)
  reason      String
  status      String   @default("Pending")
  approved_by Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  employee   Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  approvedBy User?    @relation(fields: [approved_by], references: [id], onDelete: SetNull)

  @@map("employee_leaves")
}

model EmployeeEvaluation {
  id          Int      @id @default(autoincrement())
  employee_id Int
  period      String
  rating      Float    @default(4.0)
  promoted_to String?
  remarks     String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@map("employee_evaluations")
}

model SalaryStructure {
  id                Int      @id @default(autoincrement())
  employee_id       Int
  basic_salary      Float
  hra               Float    @default(0)
  da                Float    @default(0)
  ta                Float    @default(0)
  special_allowance Float    @default(0)
  pf_enabled        Boolean  @default(true)
  esi_enabled       Boolean  @default(false)
  pt_enabled        Boolean  @default(true)
  tds_monthly       Float    @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

model Payroll {
  id                   Int       @id @default(autoincrement())
  employee_id          Int
  month                Int
  year                 Int
  working_days         Int       @default(26)
  leave_deduction_days Int       @default(0)
  gross_salary         Float
  pf_amount            Float     @default(0)
  esi_amount           Float     @default(0)
  professional_tax     Float     @default(0)
  tds_amount           Float     @default(0)
  loan_deduction       Float     @default(0)
  advance_deduction    Float     @default(0)
  arrears              Float     @default(0)
  net_salary           Float
  status               String    @default("Processed")
  paid_at              DateTime?
  bank_ref             String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, month, year])
  @@map("payrolls")
}

model ClassSection {
  id               Int      @id @default(autoincrement())
  course_id        Int
  semester         Int      @default(1)
  section_name     String   @default("A")
  room_no          String?
  class_teacher_id Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  course             Course              @relation(fields: [course_id], references: [id], onDelete: Cascade)
  classTeacher       Employee?           @relation(fields: [class_teacher_id], references: [id], onDelete: SetNull)
  subjectAllocations SubjectAllocation[]
  timetableSlots     TimetableSlot[]
  studentAttendances StudentAttendance[]

  @@map("class_sections")
}

model SubjectAllocation {
  id                  Int      @id @default(autoincrement())
  academic_session_id Int
  class_section_id    Int
  subject_id          Int
  faculty_id          Int
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  academicSession AcademicSession @relation(fields: [academic_session_id], references: [id], onDelete: Cascade)
  classSection    ClassSection    @relation(fields: [class_section_id], references: [id], onDelete: Cascade)
  subject         Subject         @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  faculty         Employee        @relation(fields: [faculty_id], references: [id], onDelete: Cascade)

  @@map("subject_allocations")
}

model TimetableSlot {
  id                    Int      @id @default(autoincrement())
  class_section_id      Int
  subject_id            Int
  faculty_id            Int
  substitute_faculty_id Int?
  day_of_week           String
  start_time            String
  end_time              String
  room_no               String
  slot_type             String   @default("Lecture")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  classSection      ClassSection @relation(fields: [class_section_id], references: [id], onDelete: Cascade)
  subject           Subject      @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  faculty           Employee     @relation("TimetableSlot_faculty_id", fields: [faculty_id], references: [id], onDelete: Cascade)
  substituteFaculty Employee?    @relation("TimetableSlot_substitute_faculty_id", fields: [substitute_faculty_id], references: [id], onDelete: SetNull)

  @@map("timetable_slots")
}

model StudentAttendance {
  id               Int      @id @default(autoincrement())
  student_id       Int
  subject_id       Int?
  class_section_id Int?
  attendance_date  DateTime
  status           String   @default("Present")
  method           String   @default("Manual")
  marked_by        Int?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  student      Student       @relation(fields: [student_id], references: [id], onDelete: Cascade)
  subject      Subject?      @relation(fields: [subject_id], references: [id], onDelete: SetNull)
  classSection ClassSection? @relation(fields: [class_section_id], references: [id], onDelete: SetNull)
  markedBy     User?         @relation(fields: [marked_by], references: [id], onDelete: SetNull)

  @@map("student_attendances")
}

model EmployeeAttendance {
  id              Int      @id @default(autoincrement())
  employee_id     Int
  attendance_date DateTime
  check_in        String?
  check_out       String?
  status          String   @default("Present")
  method          String   @default("Biometric")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  employee Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@map("employee_attendances")
}

model AttendanceCorrection {
  id              Int      @id @default(autoincrement())
  user_id         Int
  attendance_date DateTime
  reason          String
  status          String   @default("Pending")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("attendance_corrections")
}

model Exam {
  id                  Int      @id @default(autoincrement())
  name                String
  exam_type           String   @default("End-Semester")
  academic_session_id Int
  course_id           Int
  semester            Int      @default(1)
  start_date          DateTime
  end_date            DateTime
  is_published        Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  academicSession   AcademicSession    @relation(fields: [academic_session_id], references: [id], onDelete: Cascade)
  course            Course             @relation(fields: [course_id], references: [id], onDelete: Cascade)
  examSchedules     ExamSchedule[]
  examRegistrations ExamRegistration[]
  examMarks         ExamMark[]

  @@map("exams")
}

model ExamSchedule {
  id                  Int      @id @default(autoincrement())
  exam_id             Int
  subject_id          Int
  exam_date           DateTime
  start_time          String
  end_time            String
  room_no             String
  invigilator_id      Int?
  max_marks           Int      @default(100)
  passing_marks       Int      @default(40)
  question_paper_code String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  exam        Exam      @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  subject     Subject   @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  invigilator Employee? @relation(fields: [invigilator_id], references: [id], onDelete: SetNull)

  @@map("exam_schedules")
}

model ExamRegistration {
  id                Int      @id @default(autoincrement())
  exam_id           Int
  student_id        Int
  seat_no           String?
  admit_card_number String?
  is_eligible       Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  exam    Exam    @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("exam_registrations")
}

model ExamMark {
  id                  Int      @id @default(autoincrement())
  exam_id             Int
  subject_id          Int
  student_id          Int
  internal_marks      Float    @default(0)
  external_marks      Float    @default(0)
  total_marks         Float    @default(0)
  grade               String?
  grade_point         Float    @default(0)
  credits             Float    @default(4.0)
  result_status       String   @default("Pass")
  is_verified         Boolean  @default(false)
  reevaluation_status String   @default("None")
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

