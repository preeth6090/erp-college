# PostgreSQL (e.g. Neon). DATABASE_URL = pooled connection, DIRECT_URL = direct connection (used for schema changes).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Signs login session cookies. Use a long random string (>= 32 chars).
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"
# Optional
# DEFAULT_USER_PASSWORD=   # initial password for accounts the system creates
# SEED_PASSWORD=           # password for the demo accounts created by `npm run db:seed`
# BLOB_READ_WRITE_TOKEN=   # Vercel Blob token for persistent uploads (set automatically on Vercel)
